    "messages": [
      { "id": "ic_001", "time": "2025-11-12T20:18:00", "displayTime": "20:18", "from": "mook", "type": "text", "text": "谁这周想吃泰餐！！！" },
      { "id": "ic_002", "time": "2025-11-12T20:18:00", "from": "jae", "type": "text", "text": "me please 😭" },
      { "id": "ic_003", "time": "2025-11-12T20:18:00", "from": "beam", "type": "text", "text": "deadline 允许我出门的话我就去" },
      { "id": "ic_004", "time": "2025-11-12T20:18:00", "from": "tinn", "type": "text", "text": "那你这辈子都不用出门了" },
      { "id": "ic_005", "time": "2025-11-12T20:18:00", "from": "me", "type": "text", "text": "伦敦怎么天天下雨" },
      { "id": "ic_006", "time": "2025-11-12T20:18:00", "from": "nan", "type": "text", "text": "welcome to UK ka ☔" },
      { "id": "ic_007", "time": "2025-12-25T11:20:00", "displayTime": "11:20", "from": "mook", "type": "text", "text": "MERRY CHRISTMAS EVERYONE 🎄" },
      { "id": "ic_008", "time": "2025-12-25T11:20:00", "from": "ploy", "type": "text", "text": "今天终于有圣诞氛围了" },
      { "id": "ic_009", "time": "2025-12-25T11:20:00", "from": "petch", "type": "text", "text": "有人去 Winter Wonderland 吗" },
      { "id": "ic_010", "time": "2025-12-25T11:20:00", "from": "beam", "type": "text", "text": "我在家赶 due🙂" },
      { "id": "ic_011", "time": "2025-12-25T11:20:00", "from": "nan", "type": "text", "text": "圣诞节还赶 due 真的惨" },
      { "id": "ic_012", "time": "2025-12-25T11:20:00", "from": "me", "type": "text", "text": "Imperial experience" },
      { "id": "ic_013", "time": "2026-01-18T16:42:00", "displayTime": "16:42", "from": "jae", "type": "text", "text": "想念泰国的 food so bad" },
      { "id": "ic_014", "time": "2026-01-18T16:42:00", "from": "mook", "type": "text", "text": "sameeee 我要回去吃 boat noodles" },
      { "id": "ic_015", "time": "2026-01-18T16:42:00", "from": "tinn", "type": "text", "text": "伦敦一顿饭的钱够我在泰国吃三顿" },
      { "id": "ic_016", "time": "2026-01-18T16:42:00", "from": "ploy", "type": "text", "text": "别说了我刚买完菜 心碎了" },
      { "id": "ic_017", "time": "2026-01-18T16:42:00", "from": "me", "type": "text", "text": "什么时候放假" },
      { "id": "ic_018", "time": "2026-02-14T13:08:00", "displayTime": "13:08", "from": "ploy", "type": "text", "text": "Happy Valentine’s Day 💌" },
      { "id": "ic_019", "time": "2026-02-14T13:08:00", "from": "nan", "type": "text", "text": "单身的出来集合哈哈哈哈" },
      { "id": "ic_020", "time": "2026-02-14T13:08:00", "from": "petch", "type": "text", "text": "我今天只爱 chicken wings" },
      { "id": "ic_021", "time": "2026-02-14T13:08:00", "from": "beam", "type": "text", "text": "我只爱 deadline" },
      { "id": "ic_022", "time": "2026-02-14T13:08:00", "from": "mook", "type": "text", "text": "你们两个没救了" },
      { "id": "ic_023", "time": "2026-02-14T13:08:00", "from": "me", "type": "text", "text": "😑" },
      { "id": "ic_024", "time": "2026-03-22T18:35:00", "displayTime": "18:35", "from": "korn", "type": "text", "text": "提醒一下 下周有些课程的 submission" },
      { "id": "ic_025", "time": "2026-03-22T18:35:00", "from": "beam", "type": "text", "text": "不要在群里讲这个谢谢" },
      { "id": "ic_026", "time": "2026-03-22T18:35:00", "from": "tinn", "type": "text", "text": "逃避不能解决问题" },
      { "id": "ic_027", "time": "2026-03-22T18:35:00", "from": "nan", "type": "text", "text": "但可以让心情好五分钟" },
      { "id": "ic_028", "time": "2026-03-22T18:35:00", "from": "me", "type": "text", "text": "我选择暂时失忆" },
      { "id": "ic_029", "time": "2026-04-10T19:16:00", "displayTime": "19:16", "from": "mook", "type": "text", "text": "回泰国之前要不要一起吃个饭" },
      { "id": "ic_030", "time": "2026-04-10T19:16:00", "from": "jae", "type": "text", "text": "YESSSS" },
      { "id": "ic_031", "time": "2026-04-10T19:16:00", "from": "petch", "type": "text", "text": "我已经开始想念泰国了" },
      { "id": "ic_032", "time": "2026-04-10T19:16:00", "from": "ploy", "type": "text", "text": "我的行李已经超重了 😭" },
      { "id": "ic_033", "time": "2026-04-10T19:16:00", "from": "me", "type": "text", "text": "我还没开始收拾" },
      { "id": "ic_034", "time": "2026-06-20T14:10:00", "displayTime": "14:10", "from": "nan", "type": "text", "text": "有人已经回泰国了吗" },
      { "id": "ic_035", "time": "2026-06-20T14:10:00", "from": "mook", "type": "text", "text": "回了！热到不想出门" },
      { "id": "ic_036", "time": "2026-06-20T14:10:00", "from": "jae", "type": "text", "text": "但吃的真的太幸福了" },
      { "id": "ic_037", "time": "2026-06-20T14:10:00", "from": "tinn", "type": "text", "text": "你们先享受 我还在伦敦" },
      { "id": "ic_038", "time": "2026-06-20T14:10:00", "from": "beam", "type": "text", "text": "summer break 但我的 work 还没结束🙂" },
      { "id": "ic_039", "time": "2026-06-20T14:10:00", "from": "me", "type": "text", "text": "听起来大家都不太轻松" },
      { "id": "ic_040", "time": "2026-09-28T21:05:00", "displayTime": "21:05", "from": "petch", "type": "text", "text": "新学期有人要一起去 gym 吗" },
      { "id": "ic_041", "time": "2026-09-28T21:05:00", "from": "mook", "type": "text", "text": "先一起吃饭再说" },
      { "id": "ic_042", "time": "2026-09-28T21:05:00", "from": "tinn", "type": "text", "text": "你们的 priority 很明确" },
      { "id": "ic_043", "time": "2026-09-28T21:05:00", "from": "ploy", "type": "text", "text": "最近伦敦冷得好快" },
      { "id": "ic_044", "time": "2026-09-28T21:05:00", "from": "nan", "type": "text", "text": "又到了想回泰国的季节" },
      { "id": "ic_045", "time": "2026-09-28T21:05:00", "from": "me", "type": "text", "text": "我已经开始想念冬眠了" },
      { "id": "ic_046", "time": "2026-10-25T17:30:00", "displayTime": "17:30", "from": "korn", "type": "text", "text": "大家最近还好吗" },
      { "id": "ic_047", "time": "2026-10-25T17:30:00", "from": "beam", "type": "text", "text": "alive but barely" },
      { "id": "ic_048", "time": "2026-10-25T17:30:00", "from": "mook", "type": "text", "text": "same same 😭" },
      { "id": "ic_049", "time": "2026-10-25T17:30:00", "from": "jae", "type": "text", "text": "周末找时间聚一下吧" },
      { "id": "ic_050", "time": "2026-10-25T17:30:00", "from": "petch", "type": "text", "text": "count me in" },
      { "id": "ic_051", "time": "2026-10-25T17:30:00", "from": "me", "type": "text", "text": "如果没有 deadline 的话" }
    ],
    "unlocks": []
  },
  {
    "id": "chat_mom",
    "title": "Mom",
    "avatar": "/assets/line/mom/IMG_3715.jpeg",
    "color": "#ec4899",
    "isGroup": false,
    "initialUnreadCount": 0,
    "messages": [
      { "id": "mom_001", "time": "2025-09-15T16:55:00", "displayTime": "16:55", "from": "mom", "type": "text", "text": "到了吗？怎么还没消息" },
      { "id": "mom_002", "time": "2025-09-15T16:55:00", "from": "me", "type": "text", "text": "刚拿到行李" },
      { "id": "mom_003", "time": "2025-09-15T16:55:00", "from": "mom", "type": "text", "text": "飞机上睡着没有" },
      { "id": "mom_004", "time": "2025-09-15T16:55:00", "from": "me", "type": "text", "text": "睡了 但是好冷" },
      { "id": "mom_005", "time": "2025-09-15T16:55:00", "from": "mom", "type": "text", "text": "外套有穿好吗？伦敦不是泰国" },
      { "id": "mom_006", "time": "2025-09-15T16:55:00", "from": "me", "type": "text", "text": "穿了穿了" },
      { "id": "mom_007", "time": "2025-09-15T16:55:00", "from": "mom", "type": "text", "text": "到了先吃点东西，别又忙起来什么都忘了" },
      { "id": "mom_008", "time": "2025-09-15T16:55:00", "from": "me", "type": "text", "text": "知道啦" },
      { "id": "mom_009", "time": "2025-09-16T09:10:00", "displayTime": "09:10", "from": "mom", "type": "text", "text": "昨晚睡得怎么样" },
      { "id": "mom_010", "time": "2025-09-16T09:10:00", "from": "me", "type": "text", "text": "还行 时差有点乱" },
      { "id": "mom_011", "time": "2025-09-16T09:10:00", "from": "mom", "type": "text", "text": "今天去学校记得带伞" },
      { "id": "mom_012", "time": "2025-09-16T09:10:00", "from": "me", "type": "text", "text": "啊？为什么" },
      { "id": "mom_013", "time": "2025-09-16T09:10:00", "from": "mom", "type": "text", "text": "我看天气预报说要下雨" },
      { "id": "mom_014", "time": "2025-09-16T09:10:00", "from": "me", "type": "text", "text": "……还真是" },
      { "id": "mom_015", "time": "2025-10-03T20:25:00", "displayTime": "20:25", "from": "mom", "type": "text", "text": "这几天有没有好好吃饭" },
      { "id": "mom_016", "time": "2025-10-03T20:25:00", "from": "me", "type": "text", "text": "有啊" },
      { "id": "mom_017", "time": "2025-10-03T20:25:00", "from": "mom", "type": "text", "text": "你上次说有空做饭，后来呢" },
      { "id": "mom_018", "time": "2025-10-03T20:25:00", "from": "me", "type": "text", "text": "后来发现洗碗比做饭麻烦" },
      { "id": "mom_019", "time": "2025-10-03T20:25:00", "from": "mom", "type": "text", "text": "那至少吃点蔬菜" },
      { "id": "mom_020", "time": "2025-10-03T20:25:00", "from": "me", "type": "text", "text": "…妈你是不是在我房间里装监控了" },
      { "id": "mom_021", "time": "2025-11-12T19:40:00", "displayTime": "19:40", "from": "mom", "type": "text", "text": "伦敦是不是越来越冷了" },
      { "id": "mom_022", "time": "2025-11-12T19:40:00", "from": "me", "type": "text", "text": "嗯 手快冻掉了" },
      { "id": "mom_023", "time": "2025-11-12T19:40:00", "from": "mom", "type": "text", "text": "围巾带了吗" },
      { "id": "mom_024", "time": "2025-11-12T19:40:00", "from": "me", "type": "text", "text": "带了" },
      { "id": "mom_025", "time": "2025-11-12T19:40:00", "from": "mom", "type": "text", "text": "那就好。不要又为了好看穿那么少" },
      { "id": "mom_026", "time": "2025-11-12T19:40:00", "from": "me", "type": "text", "text": "😑" },
      { "id": "mom_027", "time": "2025-11-12T19:40:00", "from": "mom", "type": "text", "text": "笑什么，感冒了又要自己难受" },
      { "id": "mom_028", "time": "2025-12-25T10:15:00", "displayTime": "10:15", "from": "mom", "type": "text", "text": "Merry Christmas 🎄" },
      { "id": "mom_029", "time": "2025-12-25T10:15:00", "from": "me", "type": "text", "text": "Merry Christmas mom" },
      { "id": "mom_030", "time": "2025-12-25T10:15:00", "from": "mom", "type": "text", "text": "今天有安排吗" },
      { "id": "mom_031", "time": "2025-12-25T10:15:00", "from": "me", "type": "text", "text": "可能跟fort吃饭？" },
      { "id": "mom_032", "time": "2025-12-25T10:15:00", "from": "mom", "type": "text", "text": "挺好的，异国他乡你们还能做个伴" },
      { "id": "mom_033", "time": "2025-12-25T10:15:00", "from": "me", "type": "text", "text": "是啊" },
      { "id": "mom_034", "time": "2025-12-25T10:15:00", "from": "mom", "type": "text", "text": "给你转了点钱，去吃顿好的" },
      { "id": "mom_035", "time": "2025-12-25T10:15:00", "from": "me", "type": "text", "text": "我有钱啊妈" },
      { "id": "mom_036", "time": "2025-12-25T10:15:00", "from": "mom", "type": "text", "text": "当圣诞节礼物咯" },
      { "id": "mom_037", "time": "2026-01-01T00:08:00", "displayTime": "00:08", "from": "mom", "type": "text", "text": "新年快乐呀" },
      { "id": "mom_038", "time": "2026-01-01T00:08:00", "from": "me", "type": "text", "text": "新年快乐！" },
      { "id": "mom_039", "time": "2026-01-01T00:08:00", "from": "mom", "type": "text", "text": "新的一年身体健康，学业顺利，少熬夜" },
      { "id": "mom_040", "time": "2026-01-01T00:08:00", "from": "me", "type": "text", "text": "最后一条可以删掉吗" },
      { "id": "mom_041", "time": "2026-01-01T00:08:00", "from": "mom", "type": "text", "text": "不可以" },
      { "id": "mom_042", "time": "2026-01-01T00:08:00", "from": "me", "type": "text", "text": "🥲" },
      { "id": "mom_043", "time": "2026-01-18T18:30:00", "displayTime": "18:30", "from": "mom", "type": "text", "text": "今天家里做了你喜欢的菜" },
      { "id": "mom_044", "time": "2026-01-18T18:30:00", "from": "me", "type": "text", "text": "什么菜" },
      { "id": "mom_045", "time": "2026-01-18T18:30:00", "from": "mom", "type": "text", "text": "你猜" },
      { "id": "mom_046", "time": "2026-01-18T18:30:00", "from": "me", "type": "text", "text": "打抛猪？" },
      { "id": "mom_047", "time": "2026-01-18T18:30:00", "from": "mom", "type": "text", "text": "这么聪明" },
      { "id": "mom_048", "time": "2026-01-18T18:30:00", "from": "me", "type": "text", "text": "☹️现在发给我是不是故意的" },
      { "id": "mom_049", "time": "2026-01-18T18:30:00", "from": "mom", "type": "text", "text": "哈哈哈哈，等你回来再给你做" },
      { "id": "mom_050", "time": "2026-01-18T18:30:00", "from": "me", "type": "text", "text": "我现在就想吃！" },
      { "id": "mom_051", "time": "2026-02-14T09:20:00", "displayTime": "09:20", "from": "mom", "type": "text", "text": "今天记得吃饭，不要只顾着做作业" },
      { "id": "mom_052", "time": "2026-02-14T09:20:00", "from": "me", "type": "text", "text": "今天怎么大家都在提醒我吃饭" },
      { "id": "mom_053", "time": "2026-02-14T09:20:00", "from": "mom", "type": "text", "text": "因为你每次忙起来都忘记" },
      { "id": "mom_054", "time": "2026-02-14T09:20:00", "from": "me", "type": "text", "text": "有那么夸张吗" },
      { "id": "mom_055", "time": "2026-02-14T09:20:00", "from": "mom", "type": "text", "text": "你自己想想" },
      { "id": "mom_056", "time": "2026-02-14T09:20:00", "from": "me", "type": "text", "text": "……好吧" },
      { "id": "mom_057", "time": "2026-03-05T22:10:00", "displayTime": "22:10", "from": "mom", "type": "text", "text": "今天怎么样？考试还顺利吗" },
      { "id": "mom_058", "time": "2026-03-05T22:10:00", "from": "me", "type": "text", "text": "还行 但有一道题很烦" },
      { "id": "mom_059", "time": "2026-03-05T22:10:00", "from": "mom", "type": "text", "text": "不会的题就先放着，不要一直钻牛角尖" },
      { "id": "mom_060", "time": "2026-03-05T22:10:00", "from": "me", "type": "text", "text": "我知道 但就是不甘心" },
      { "id": "mom_061", "time": "2026-03-05T22:10:00", "from": "mom", "type": "text", "text": "那就休息一下再看，脑子也需要休息" },
      { "id": "mom_062", "time": "2026-03-05T22:10:00", "from": "me", "type": "text", "text": "嗯嗯" },
      { "id": "mom_063", "time": "2026-04-10T16:30:00", "displayTime": "16:30", "from": "mom", "type": "text", "text": "机票买好了吗" },
      { "id": "mom_064", "time": "2026-04-10T16:30:00", "from": "me", "type": "text", "text": "买好了" },
      { "id": "mom_065", "time": "2026-04-10T16:30:00", "from": "mom", "type": "text", "text": "回来的日期再发我一次" },
      { "id": "mom_066", "time": "2026-04-10T16:30:00", "from": "me", "type": "text", "text": "你不是已经有了吗" },
      { "id": "mom_067", "time": "2026-04-10T16:30:00", "from": "mom", "type": "text", "text": "我怕记错" },
      { "id": "mom_068", "time": "2026-04-10T16:30:00", "from": "me", "type": "text", "text": "截图发你了" },
      { "id": "mom_069", "time": "2026-04-10T16:30:00", "from": "mom", "type": "text", "text": "收到。行李不要等最后一天才收" },
      { "id": "mom_070", "time": "2026-04-10T16:30:00", "from": "me", "type": "text", "text": "……知道了" },
      { "id": "mom_071", "time": "2026-05-02T20:45:00", "displayTime": "20:45", "from": "mom", "type": "text", "text": "今天hana把桌上的东西全弄下来了" },
      { "id": "mom_072", "time": "2026-05-02T20:45:00", "from": "me", "type": "text", "text": "哈哈哈哈它又干嘛" },
      { "id": "mom_073", "time": "2026-05-02T20:45:00", "from": "mom", "type": "text", "text": "把你小时候的照片也弄掉了" },
      { "id": "mom_074", "time": "2026-05-02T20:45:00", "from": "me", "type": "text", "text": "那它眼光不错" },
      { "id": "mom_075", "time": "2026-05-02T20:45:00", "from": "mom", "type": "text", "text": "你小时候明明很乖" },
      { "id": "mom_076", "time": "2026-05-02T20:45:00", "from": "me", "type": "text", "text": "关键词是小时候" },
      { "id": "mom_077", "time": "2026-05-02T20:45:00", "from": "mom", "type": "text", "text": "现在也不算太坏啦" },
      { "id": "mom_078", "time": "2026-06-20T14:05:00", "displayTime": "14:05", "from": "mom", "type": "text", "text": "最近天气怎么样" },
      { "id": "mom_079", "time": "2026-06-20T14:05:00", "from": "me", "type": "text", "text": "还可以 终于不用每天穿外套了" },
      { "id": "mom_080", "time": "2026-06-20T14:05:00", "from": "mom", "type": "text", "text": "放假了就多出去走走" },
      { "id": "mom_081", "time": "2026-06-20T14:05:00", "from": "me", "type": "text", "text": "我在补觉" },
      { "id": "mom_082", "time": "2026-06-20T14:05:00", "from": "mom", "type": "text", "text": "你在伦敦到底睡了多少觉" },
      { "id": "mom_083", "time": "2026-06-20T14:05:00", "from": "me", "type": "text", "text": "欠下的总要还" },
      { "id": "mom_084", "time": "2026-06-20T14:05:00", "from": "mom", "type": "text", "text": "那也要记得按时吃饭" },
      { "id": "mom_085", "time": "2026-08-16T19:20:00", "displayTime": "19:20", "from": "mom", "type": "text", "text": "今天跟亲戚吃饭，他们还问你什么时候回来" },
      { "id": "mom_086", "time": "2026-08-16T19:20:00", "from": "me", "type": "text", "text": "怎么每次都问这个" },
      { "id": "mom_087", "time": "2026-08-16T19:20:00", "from": "mom", "type": "text", "text": "因为大家想你呀" },
      { "id": "mom_088", "time": "2026-08-16T19:20:00", "from": "me", "type": "text", "text": "下次回去请他们吃饭好了" },
      { "id": "mom_089", "time": "2026-08-16T19:20:00", "from": "mom", "type": "text", "text": "你先把自己照顾好再说" },
      { "id": "mom_090", "time": "2026-08-16T19:20:00", "from": "me", "type": "text", "text": "收到 🫡" },
      { "id": "mom_091", "time": "2026-09-28T21:15:00", "displayTime": "21:15", "from": "mom", "type": "text", "text": "新学期开始了吧" },
      { "id": "mom_092", "time": "2026-09-28T21:15:00", "from": "me", "type": "text", "text": "嗯 已经开始忙了" },
