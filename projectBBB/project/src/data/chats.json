      { "id": "pond_001", "time": "2025-12-25T00:00:00", "displayTime": "00:00", "from": "pond", "type": "text", "text": "圣诞快乐🎄" },
      { "id": "pond_002", "time": "2025-12-25T00:00:00", "from": "me", "type": "text", "text": "你也" },
      { "id": "pond_003", "time": "2026-01-01T00:00:00", "displayTime": "00:00", "from": "pond", "type": "text", "text": "新年快乐🎉" },
      { "id": "pond_004", "time": "2026-01-01T00:20:00", "displayTime": "00:20", "from": "pond", "type": "text", "text": "不是群发" },
      { "id": "pond_005", "time": "2026-01-01T00:20:00", "from": "me", "type": "text", "text": "噢" },
      { "id": "pond_006", "time": "2026-01-01T03:22:00", "displayTime": "03:22", "from": "me", "type": "text", "text": "新年快乐" },
      { "id": "pond_007", "time": "2026-01-01T03:22:00", "from": "me", "type": "text", "text": "不是群发" },
      { "id": "pond_008", "time": "2026-02-14T00:00:00", "displayTime": "00:00", "from": "pond", "type": "text", "text": "情人节快乐🌹" },
      { "id": "pond_009", "time": "2026-02-14T00:00:00", "from": "me", "type": "text", "text": "？" },
      { "id": "pond_010", "time": "2026-02-14T00:00:00", "from": "pond", "type": "text", "text": "嗷，这个点还有空回我信息" },
      { "id": "pond_011", "time": "2026-02-14T00:00:00", "from": "pond", "type": "text", "text": "情人节一个人？" },
      { "id": "pond_012", "time": "2026-02-14T00:00:00", "from": "me", "type": "text", "text": "没空" },
      { "id": "pond_013", "time": "2026-02-14T02:34:00", "displayTime": "02:34", "from": "me", "type": "text", "text": "在赶due" },
      { "id": "pond_014", "time": "2026-02-14T02:42:00", "displayTime": "02:42", "from": "me", "type": "text", "text": "一个人" },
      { "id": "pond_015", "time": "2026-02-14T02:48:00", "displayTime": "02:48", "from": "me", "type": "text", "text": "…看来你不是一个人" },
      { "id": "pond_016", "time": "2026-02-14T04:10:00", "displayTime": "04:10", "from": "pond", "type": "text", "text": "？刚在开车" },
      { "id": "pond_017", "time": "2026-02-14T04:10:00", "from": "pond", "type": "image", "image": "/photos/5068B05D-A2C4-4334-9806-B2F56C27B9B5.png" },
      { "id": "pond_018", "time": "2026-02-14T04:10:00", "from": "pond", "type": "text", "text": "给你看曼哈顿的夜景" },
      { "id": "pond_019", "time": "2026-02-14T04:10:00", "from": "me", "type": "text", "text": "还挺高级" },
      { "id": "pond_020", "time": "2026-02-14T04:10:00", "from": "pond", "type": "text", "text": "还没睡？" },
      { "id": "pond_021", "time": "2026-02-14T04:10:00", "from": "pond", "type": "text", "text": "你那快四点了吧" },
      { "id": "pond_022", "time": "2026-02-14T04:10:00", "from": "me", "type": "text", "text": "4.12" },
      { "id": "pond_023", "time": "2026-02-14T04:10:00", "from": "pond", "type": "text", "text": "不要命了还是明天不上课了" },
      { "id": "pond_024", "time": "2026-02-14T04:10:00", "from": "me", "type": "text", "text": "……那coursework写不完啊。。" },
      { "id": "pond_025", "time": "2026-02-14T04:10:00", "from": "me", "type": "text", "text": "debug比你还难懂" },
      { "id": "pond_026", "time": "2026-02-14T04:10:00", "from": "pond", "type": "text", "text": "…？" },
      { "id": "pond_027", "time": "2026-02-14T04:10:00", "from": "me", "type": "text", "text": "不扯了真要睡了" },
      { "id": "pond_028", "time": "2026-02-14T04:10:00", "from": "me", "type": "text", "text": "我明天早课。" },
      { "id": "pond_029", "time": "2026-02-14T04:10:00", "from": "pond", "type": "text", "text": "还差哪儿红？发我我先帮你找找" },
      { "id": "pond_030", "time": "2026-02-14T04:10:00", "from": "me", "type": "text", "text": "🫪" },
      { "id": "pond_031", "time": "2026-02-14T04:10:00", "from": "me", "type": "text", "text": "谢谢" },
      { "id": "pond_032", "time": "2026-02-14T04:10:00", "from": "me", "type": "text", "text": "但我已经改完了" },
      { "id": "pond_033", "time": "2026-02-14T04:10:00", "from": "pond", "type": "text", "text": "……" },
      { "id": "pond_034", "time": "2026-02-14T04:10:00", "from": "me", "type": "text", "text": "STEM slave😇" },
      { "id": "pond_035", "time": "2026-02-14T04:10:00", "from": "pond", "type": "text", "text": "……好梦" },
      { "id": "pond_036", "time": "2026-04-11T14:28:00", "displayTime": "14:28", "from": "pond", "type": "text", "text": "你宋干回泰国吗？" },
      { "id": "pond_037", "time": "2026-04-11T14:28:00", "from": "me", "type": "text", "text": "回啊，没课为什么不回" },
      { "id": "pond_038", "time": "2026-04-11T14:28:00", "from": "pond", "type": "text", "text": "…噢" },
      { "id": "pond_039", "time": "2026-04-11T14:28:00", "from": "pond", "type": "text", "text": "替我问fort好" },
      { "id": "pond_040", "time": "2026-04-11T14:28:00", "from": "me", "type": "text", "text": "你不回？" },
      { "id": "pond_041", "time": "2026-04-11T14:28:00", "from": "pond", "type": "text", "text": "。我开学都快一个月了" },
      { "id": "pond_042", "time": "2026-04-11T14:28:00", "from": "me", "type": "text", "text": "😯" },
      { "id": "pond_043", "time": "2026-04-11T14:28:00", "from": "pond", "type": "text", "text": "你一点都不关心我" },
      { "id": "pond_044", "time": "2026-04-11T14:28:00", "from": "me", "type": "text", "text": "emmm那我下回注意？" },
      { "id": "pond_045", "time": "2026-04-11T14:28:00", "from": "pond", "type": "text", "text": "…………" },
      { "id": "pond_046", "time": "2026-04-11T14:28:00", "from": "pond", "type": "text", "text": "算了" },
      { "id": "pond_047", "time": "2026-04-11T14:28:00", "from": "me", "type": "text", "text": "嗯？" },
      { "id": "pond_048", "time": "2026-04-11T14:28:00", "from": "pond", "type": "text", "text": "phuwin" },
      { "id": "pond_049", "time": "2026-04-11T14:28:00", "from": "me", "type": "text", "text": "嗯" },
      { "id": "pond_050", "time": "2026-04-11T14:28:00", "from": "pond", "type": "text", "text": "五个小时时差是不是真的很多" },
      { "id": "pond_051", "time": "2026-04-11T14:28:00", "from": "me", "type": "text", "text": "你想说什么" },
      { "id": "pond_052", "time": "2026-04-11T14:28:00", "from": "pond", "type": "text", "text": "不知道" },
      { "id": "pond_053", "time": "2026-04-11T14:28:00", "from": "pond", "type": "text", "text": "你喜欢伦敦吗？" },
      { "id": "pond_054", "time": "2026-04-11T14:28:00", "from": "me", "type": "text", "text": "…就，还行？" },
      { "id": "pond_055", "time": "2026-04-11T14:28:00", "from": "me", "type": "text", "text": "除了有点冷，都挺好的" },
      { "id": "pond_056", "time": "2026-04-11T14:28:00", "from": "pond", "type": "text", "text": "你带围巾肯定很好看" },
      { "id": "pond_057", "time": "2026-04-11T14:28:00", "from": "pond", "type": "text", "text": "London vibe" },
      { "id": "pond_058", "time": "2026-04-11T14:28:00", "from": "me", "type": "text", "text": "🤨" },
      { "id": "pond_059", "time": "2026-04-11T14:28:00", "from": "me", "type": "text", "text": "怎么感觉你意有所指" },
      { "id": "pond_060", "time": "2026-04-11T14:28:00", "from": "pond", "type": "text", "text": "嗯" },
      { "id": "pond_061", "time": "2026-04-11T14:28:00", "from": "pond", "type": "text", "text": "薄情又狠心的伦敦" },
      { "id": "pond_062", "time": "2026-04-11T14:28:00", "from": "me", "type": "text", "text": "。。。" },
      { "id": "pond_063", "time": "2026-04-11T14:28:00", "from": "pond", "type": "text", "text": "我要认真上课了" },
      { "id": "pond_064", "time": "2026-04-11T14:28:00", "from": "me", "type": "text", "text": "早该" },
      { "id": "pond_065", "time": "2026-04-19T23:16:00", "displayTime": "23:16", "from": "pond", "type": "text", "text": "伦敦最近还冷吗" },
      { "id": "pond_066", "time": "2026-04-19T23:16:00", "from": "me", "type": "text", "text": "你怎么总问这个" },
      { "id": "pond_067", "time": "2026-05-07T00:42:00", "displayTime": "00:42", "from": "pond", "type": "text", "text": "刚路过了一家很多人排队的拉面馆，感觉很好吃，那个装修也是你会喜欢的" },
      { "id": "pond_068", "time": "2026-05-07T00:42:00", "from": "me", "type": "text", "text": "给我推荐纽约的店？" },
      { "id": "pond_069", "time": "2026-05-07T00:42:00", "from": "pond", "type": "text", "text": "不行吗" },
      { "id": "pond_070", "time": "2026-06-02T22:08:00", "displayTime": "22:08", "from": "me", "type": "text", "text": "你上次说的那家店叫什么来着" },
      { "id": "pond_071", "time": "2026-06-02T22:08:00", "from": "pond", "type": "text", "text": "怎么突然问" },
      { "id": "pond_072", "time": "2026-06-02T22:08:00", "from": "me", "type": "text", "text": "随便问问" },
      { "id": "pond_073", "time": "2026-06-02T22:08:00", "from": "pond", "type": "text", "text": "聊天记录往上翻。" },
      { "id": "pond_074", "time": "2026-06-02T22:08:00", "displayTime": "06:23", "from": "pond", "type": "text", "text": "你要来纽约玩吗？" },
      { "id": "pond_075", "time": "2026-06-02T22:08:00", "displayTime": "07:22", "from": "me", "type": "text", "text": "啊？" },
      { "id": "pond_076", "time": "2026-06-02T22:08:00", "from": "pond", "type": "text", "text": "……喝多了，当我没问" },
      { "id": "pond_077", "time": "2026-07-16T14:55:00", "displayTime": "14:55", "from": "pond", "type": "text", "text": "Fort 说你最近在忙竞赛？" },
      { "id": "pond_078", "time": "2026-07-16T14:55:00", "from": "me", "type": "text", "text": "？你什么时候和他这么熟了" },
      { "id": "pond_079", "time": "2026-07-16T14:55:00", "from": "pond", "type": "text", "text": "啊？" },
      { "id": "pond_080", "time": "2026-07-16T14:55:00", "from": "me", "type": "text", "text": "我上午才和他说的你就知道了" },
      { "id": "pond_081", "time": "2026-07-16T14:55:00", "from": "pond", "type": "text", "text": "…他和gem打电话我在旁边听到的" },
      { "id": "pond_082", "time": "2026-07-16T14:55:00", "from": "me", "type": "text", "text": "…噢" },
      { "id": "pond_083", "time": "2026-07-16T16:30:00", "displayTime": "16:30", "from": "pond", "type": "text", "text": "我和fort太熟你会吃醋吗？" },
      { "id": "pond_084", "time": "2026-07-16T16:30:00", "from": "me", "type": "text", "text": "？？？" },
      { "id": "pond_085", "time": "2026-09-11T20:34:00", "displayTime": "20:34", "from": "me", "type": "text", "text": "你那天是不是有话没说完" },
      { "id": "pond_086", "time": "2026-09-11T20:34:00", "from": "pond", "type": "text", "text": "哪天" },
      { "id": "pond_087", "time": "2026-09-11T20:34:00", "from": "me", "type": "text", "text": "……" },
      { "id": "pond_088", "time": "2026-09-11T20:34:00", "from": "pond", "type": "text", "text": "太久了不记得了" },
      { "id": "pond_089", "time": "2026-09-11T20:34:00", "from": "me", "type": "text", "text": "👌" },
      { "id": "pond_090", "time": "2026-10-21T08:12:00", "displayTime": "08:12", "from": "pond", "type": "text", "text": "如果你当初来纽约" },
      { "id": "pond_091", "time": "2026-10-21T08:20:00", "displayTime": "08:20", "from": "me", "type": "text", "text": "什么纽约？我刚睡醒" },
      { "id": "pond_092", "time": "2026-10-21T08:20:00", "from": "me", "type": "text", "text": "一会儿说我要迟到了" },
      { "id": "pond_093", "time": "2026-10-21T08:20:00", "from": "pond", "type": "text", "text": "昨晚又熬夜了？" },
      { "id": "pond_094", "time": "2026-10-21T08:20:00", "from": "me", "type": "text", "text": "不熬写得完吗问这😇" },
      { "id": "pond_095", "time": "2026-10-21T08:20:00", "from": "pond", "type": "text", "text": "…路上小心" },
      { "id": "pond_096", "time": "2026-10-21T09:11:00", "displayTime": "09:11", "from": "me", "type": "text", "text": "你刚说纽约然后呢？" },
      { "id": "pond_097", "time": "2026-10-21T09:11:00", "from": "pond", "type": "text", "text": "没事了" },
      { "id": "pond_098", "time": "2026-10-21T09:11:00", "from": "pond", "type": "text", "text": "刚突然脑热，转头就不记得了" },
      { "id": "pond_099", "time": "2026-10-21T09:11:00", "from": "me", "type": "text", "text": "行，我继续上课了" },
      { "id": "pond_100", "time": "2026-10-21T09:11:00", "from": "pond", "type": "text", "text": "嗯" },
      { "id": "pond_101", "time": "2026-10-25T09:20:00", "displayTime": "09:20", "from": "pond", "type": "text", "text": "…好想你" },
      { "id": "pond_102", "time": "2026-10-25T09:20:00", "from": "pond", "type": "text", "text": "对不起，不想打扰你赶due的" },
      { "id": "pond_103", "time": "2026-10-25T09:20:00", "from": "pond", "type": "text", "text": "但我真的想不明白我们为什么会变成现在这样" },
      { "id": "pond_104", "time": "2026-10-25T09:20:00", "from": "pond", "type": "text", "text": "我有点受不了了……" },
      { "id": "pond_105", "time": "2026-10-25T09:20:00", "from": "pond", "type": "text", "text": "我们不玩嘴硬游戏了，我认输好不好？" },
      { "id": "pond_106", "time": "2026-10-25T09:20:00", "from": "pond", "type": "text", "text": "我不想每天都只能像个小偷一样想方设法从gem哪里套你的近况了…" },
      { "id": "pond_107", "time": "2026-10-25T09:20:00", "from": "pond", "type": "text", "text": "我不怪你赌气改到伦敦了好不好？至少我们多多联系？其实五个小时的时差也没有很长对吧？我们偶尔也能通点电话打点是视讯什么的？" },
      { "id": "pond_108", "time": "2026-10-25T09:20:00", "from": "pond", "type": "text", "text": "对不起，我真的太想你了" },
      { "id": "pond_109", "time": "2026-10-25T09:20:00", "from": "pond", "type": "text", "text": "我都好久没有听到你的声音了……" },
      { "id": "pond_110", "time": "2026-10-25T09:20:00", "from": "pond", "type": "call", "callType": "missed" },
      { "id": "pond_111", "time": "2026-10-25T09:20:00", "from": "pond", "type": "text", "text": "别对我这么狠……" }
    ],
    "unlocks": []
  },
